{
  "name": "@jlap/taflog",
  "version": "0.3.0",
  "description": "Minimalist CLI time tracker for your job. \"Taf\" is French slang for work.",
  "type": "module",
  "bin": {
    "taflog": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node src/main.ts",
    "pretest": "npm run build",
    "test": "node --test",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "time",
    "timer",
    "tracker",
    "time-tracking",
    "timesheet",
    "work",
    "taf",
    "minimalist"
  ],
  "license": "MIT",
  "author": "Jérémie Lapointe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayLap/taflog.git"
  },
  "bugs": {
    "url": "https://github.com/JayLap/taflog/issues"
  },
  "homepage": "https://github.com/JayLap/taflog#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
